# Required
MONGODB_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Server
NODE_ENV=development
PORT=4000
BASE_DOMAIN=assesshub.com
CORS_ORIGIN=http://localhost:5173
DEFAULT_TENANT_SUBDOMAIN=
# Keep stable — changing this disconnects existing tenant databases
TENANT_DB_PREFIX=tm_tenant_
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform admin (optional)
PLATFORM_ADMIN_API_KEY=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_PASSWORD_HASH=
PLATFORM_ADMIN_JWT_SECRET=
PLATFORM_ADMIN_TOKEN_EXPIRES_IN=8h

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@assesshub.com

# AI (optional)
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GROQ_CHAT_MODEL=llama-3.1-8b-instant
AI_CHAT_INTENTIONS_EXTRA=
AI_CHAT_CONSTRAINTS_EXTRA=

# Uploads
KB_MAX_UPLOAD_BYTES=12582912

# Optional: fix local querySrv ECONNREFUSED (comma-separated). Dev defaults to 8.8.8.8,1.1.1.1
# DNS_SERVERS=8.8.8.8,1.1.1.1

Email: platform@assesshub.com
Password: Password123!